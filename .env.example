# ==========================================
# 黄金、科技股与美联储宏观自动追踪看板 - 环境变量配置
# 复制此文件为 .env 并填入真实信息
# ==========================================

# --- SMTP 邮件配置 ---
# QQ邮箱示例 (smtp.qq.com:587)
# 163邮箱示例 (smtp.163.com:465)
# Gmail示例 (smtp.gmail.com:587)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=587
SENDER_EMAIL=your_email@qq.com
SMTP_PASSWORD=your_smtp_authorization_code
RECEIVER_EMAIL=receiver@example.com

# --- 数据源 API 密钥 (可选, 缺失时自动降级使用免费接口) ---
# FRED API Key: 免费注册 https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# --- GitHub Actions 定时配置 ---
# 每日看板: 周一至周五 UTC 21:00 (北京时间次日 05:00, 美股收盘后)
# 月度报告: 每月1号 UTC 01:00 (北京时间 09:00)
